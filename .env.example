# .env.example — copy to .env and fill in your values
# This file IS committed. .env is NOT committed.

# Override the device udid from config.yaml
# DEVICE_UDID=emulator-5554

# Override for a physical device
# DEVICE_UDID=R58M123ABCD

# OTP API token for email-based OTP resolution
# OTP_API_TOKEN=your_token_here
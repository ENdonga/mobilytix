# ============================================================
# Mobilytix local configuration overrides
# Copy this file to .env and fill in your values.
# .env is in .gitignore and will never be committed.
# See docs/ENV_OVERRIDE_GUIDE.md for full documentation.
# ============================================================

# Switch execution target — local (default) or sauce_labs
#EXECUTION_MODE=local

# ---- APK source (CI + local override) ----------------------
# Override to use a different APK without changing config.yaml
#APK_DOWNLOAD_URL=https://github.com/your-org/your-app/releases/download/1.0.0/app.apk
#APK_VERSION=1.0.0

# ---- Device ------------------------------------------------
#DEVICE_UDID=emulator-5554
#DEVICE_PLATFORM_VERSION=14
#DEVICE_NO_RESET=false
#DEVICE_FULL_RESET=false

# ---- Appium server -----------------------------------------
#APPIUM_HOST=127.0.0.1
#APPIUM_PORT=4723
#APPIUM_AUTO_START=true
#APPIUM_LOG_LEVEL=warn

# ---- Timeouts ----------------------------------------------
#EXPLICIT_TIMEOUT=15
#PAGE_LOAD_TIMEOUT=30

# ---- Sauce Labs Demo App test credentials ------------------
# Used by LoginTest and CatalogTest — these are app login credentials
#SAUCE_USERNAME=bod@example.com
#SAUCE_PASSWORD=10203040
#SAUCE_LOCKED_USERNAME=alice@example.com

# ---- Sauce Labs cloud execution ----------------------------
# REQUIRED - tests will fail immediately at setup if these are not set
# Sauce Labs account credentials — from saucelabs.com → Account → User Settings
#SAUCE_LABS_USERNAME=<YOUR_SAUCELABS_USERNAME>
#SAUCE_LABS_ACCESS_KEY=<YOUR_SAUCELABS_ACCESS_KEY>

# ---- OTP / SSO ---------------------------------------------
#OTP_API_TOKEN=your_token_here
#SSO_USERNAME=user@example.com
#SSO_PASSWORD=your_password_here

# ---- Reporting ---------------------------------------------
#EXTENT_OUTPUT_PATH=target/extent-reports/mobilytix-report.html
#SCREEN_RECORDING_ENABLED=false
#SCREENSHOT_ON_FAILURE=true
#SCREENSHOT_ON_PASS=false